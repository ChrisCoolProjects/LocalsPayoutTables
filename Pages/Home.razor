	.table-grid{
		display: grid;
		grid-template-columns: repeat(2, 1fr); /* 2 tables per row */
		gap: 20px; /* Space between tables */
		margin-bottom: 20px;
	}

	.table-container{
		display: flex; /* Ensures proper flex container behavior */
		flex-direction: column; /* Stacks the table rows vertically */
		border: 1px solid #ccc;
		padding: 10px;
		display: flex;
		align-items: stretch; /* Ensures full height in grid cell */
	}

	.table {
		width: 100%;
		border-collapse: collapse;
		table-layout: fixed; /* Ensures uniform width of table columns */
		flex-grow: 1; /* Ensures table expands to fill the container */
	}

	.table th, .table td {
		border: 1px solid #ddd;
		padding: 8px;
		text-align: center;
	}

</style>
<PageTitle>Payouts</PageTitle>

<h1>Payouts</h1>

<p>This component displays earnings from each QDB.</p>

@if (tdata == null)
{
	<p><em>Loading...</em></p>
	//<p>@tdata.Data.Tournaments.Nodes.Select(e => e.Name)</p>
}
else
{
	@foreach (var eventList in tdata.Data.Tournaments.Nodes.Select(e => e.Events))
	{
		<div class="table-grid">
		@foreach (var myEvent in eventList)
		{
			if (myEvent.Name == "QDB Dinner Headcount") continue;

			<div class="table-container">
				@{payoutList = PayoutCalculator.CalcPayout(myEvent.NumEntrants).ToList();}
				<h3>@myEvent.Name</h3>
				<h4>@($"Number of entrants: {myEvent.NumEntrants}")</h4>
				<p>@($"Prize Pool: ${payoutList.Sum()}")</p>
				<table class="table">
					<thead>
						<tr>
							<th>Placement</th>
							<th>Name</th>
							<th>Earnings</th>
						</tr>
					</thead>
					<tbody>
						@for (int i = 0; i < payoutList.Count; i++)
						{
							var payoutItem = payoutList.ElementAt(i);
							var standingItem = myEvent.Standings.Nodes.ElementAt(i);
							<tr>
								<td>@IntToPodiumName(standingItem.Placement)</td>
								<td>@standingItem.Player.gamerTag</td>
								<td>$@payoutItem</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		</div>
	}
}
