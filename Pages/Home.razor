	.table-grid{
		display: grid;
		grid-template-columns: repeat(4, 1fr); /* 2 tables per row */
		gap: 20px; /* Space between tables */
		margin-bottom: 20px;
		overflow: auto;
	}

	.table-container{
		display: flex; /* Ensures proper flex container behavior */
		flex-direction: column; /* Stacks the table rows vertically */
		border: 1px solid #ccc;
		padding: 10px;
		display: flex;
		align-items: stretch; /* Ensures full height in grid cell */
	}

	.table {
		width: 100%;
		border-collapse: collapse;
		table-layout: fixed; /* Ensures uniform width of table columns */
		flex-grow: 1; /* Ensures table expands to fill the container */
	}

	.table th, .table td {
		border: 1px solid #ddd;
		padding: 8px;
		text-align: center;
		word-wrap: anywhere;
	}
	
	.form-control{
		width: 10ch;
	}
</style>
<PageTitle>Payouts</PageTitle>

<h1>Payouts</h1>

<p>This page displays the history of payouts for each Quickdraw Brawl!</p>
<h3>
	<div class="d-inline-flex align-items-center mb-2">
		<label for="aInput" class="me-2">Calcuate Payout for a Tournament with </label>
		<InputNumber @bind-Value="A" id="aInput" class="form-control" Placeholder="##" Min="1" Max="9999" /> 
		<span class="ms-2">Entrants.</span>
	</div>
</h3>

@{
	if(A != null){

	var myList = CalcPayout((int)A); int myCounter = 0;
	<table class="table">
		<thead>
			<tr>
				<th>Placement</th>
				<th>Earnings</th>
			</tr>
		</thead>
		@foreach (var listItem in myList)
		{
			<tbody>
				<tr>
					<td>@IntToPodiumName(++myCounter)</td>
					<td>$@System.Math.Round(listItem, 2)</td>
				</tr>
			</tbody>
		}
		<tr>
			<td>Total Prize Pool</td>
			<td>$@myList.Sum()</td>
		</tr>
	</table>
		<br />
	}
}
@if (tdata == null)
{
	<p><em>Loading...</em></p>
	//<p>@tdata.Data.Tournaments.Nodes.Select(e => e.Name)</p>
}
else
{
	<p>Click <a href="/leaderboard" @onclick="OnButtonClick">here</a> to see a leaderboard for all earnings.</p>
	@foreach(var tournament in tdata.Data.Tournaments.Nodes)
		{
			<div class="table-grid">
			@foreach (var myEvent in tournament.Events)
			{
							firstAccordion = false;
				if (myEvent.Name == "QDB Dinner Headcount" || myEvent.NumEntrants == 0) continue;
				payoutList = CalcPayout(myEvent.NumEntrants).ToList();
				<Card Class ="mb-4" Style="width:auto; min-width: 27.5rem; box-shadow: 0px 2.5px 2.5px 3.5px rgba(200, 200, 200, 0.35)" TextAlignment="Alignment.Center" >
					<CardBody>
						<CardTitle>@myEvent.Name</CardTitle>
							<CardSubTitle Class="text-muted mb-2">@($"{myEvent.NumEntrants} Entrants")</CardSubTitle>
							<CardSubTitle Class="text-muted mb-2">@($"${CalcPayout(myEvent.NumEntrants).ToList().Sum()} Pot")</CardSubTitle>
							<div style="align-content: space-evenly">
								<table class="table">
									<thead>
										<tr>
											<th>Placement</th>
											<th>Name</th>
											<th>Earnings</th>
										</tr>
									</thead>
							<tbody>
								@for(int i = 0; i < payoutList.Count && i < myEvent.Standings.Nodes.Count; i++)
								{

									payoutList = CalcPayout(myEvent.NumEntrants).ToList();
									var payoutItem = payoutList.ElementAt(i);
									var standingItem = myEvent.Standings.Nodes.ElementAt(i);
									//<li class="list-group-item">@($"{IntToPodiumName(standingItem.Placement)} {standingItem.Player.gamerTag} ${String.Format("{0:0.00}",payoutItem)}")</li>
									<tr>
										<td>@IntToPodiumName(standingItem.Placement)</td>
										<td>@standingItem.Player.gamerTag</td>
										<td>$@(String.Format("{0:0.00}", payoutItem))</td>
									</tr>
									}
							</tbody>
							</table>
							</div>
						</CardBody>
				</Card>
			}
		</div>

		}
	}
}
@code {

	private static TournamentResponse tdata;
	private List<double> payoutList;
	private int? A { get; set; } = null;
	bool firstAccordion = true;
	protected override async Task OnInitializedAsync()
	{

		// Simulate asynchronous loading to demonstrate streaming rendering
		await Task.Delay(500);
		await callAPI();
	}
	private async void OnButtonClick()
	{
		var leaderboardDataHolder = tdata.Data.Tournaments.Nodes.SelectMany(e => e.Events);
		List<Entrant> myLeaderboard = new List<Entrant>();
		foreach(var eventItem in leaderboardDataHolder)
		{
			if (eventItem.Name == "QDB Dinner Headcount" || eventItem.NumEntrants < 5 || eventItem.Name.Contains("Spin")) continue;
			payoutList = CalcPayout(eventItem.NumEntrants);
			for (int i = 0; i < payoutList.Count && i < eventItem.Standings.Nodes.Count; i++)
			{
				var payoutItem = payoutList.ElementAt(i);
				var standingItem = eventItem.Standings.Nodes.ElementAt(i);
				//Console.Write($"   {IntToPodiumName(standingItem.Placement)} place: {standingItem.Player.gamerTag} won ${payoutList.ElementAt(standingItem.Placement - 1)} ");
				var currentPlayer = myLeaderboard.FirstOrDefault(x => x.Id == standingItem.Player.Id);
				if (currentPlayer == null)
				{
					currentPlayer = new Entrant
						{
							Id = standingItem.Player.Id,
							Name = standingItem.Player.gamerTag
						};
					myLeaderboard.Add(currentPlayer);
					//Console.WriteLine(" (Added to leaderboard)");
				}
				else { Console.WriteLine(); }
				myLeaderboard.FirstOrDefault(x => x.Id == currentPlayer.Id).Earnings += payoutItem;
			}
		}
		NavState.LeaderboardData = myLeaderboard.OrderByDescending(x => x.Earnings).ToList();
		await SessionStorage.SetItemAsync("LeaderboardData", myLeaderboard.OrderByDescending(x => x.Earnings).ToList());
		NavManager.NavigateTo("/leaderboard");
	}

