@page "/payouts"
@inject TournamentDataService TournamentData
@attribute [StreamRendering]

<style>
	td{
		margin: 0 auto;
	}
</style>
<PageTitle>Payouts</PageTitle>

<h1>Payouts</h1>

<p>This component displays earnings from each QDB.</p>

@if (loadError != null)
{
	<p class="text-danger">@loadError</p>
}
else if (tdata == null)
{
	<p><em>Loading...</em></p>
	//<p>@tdata.Data.Tournaments.Nodes.Select(e => e.Name)</p>
}
else
{
	@foreach (var eventList in tdata.Data.Tournaments.Nodes.Select(e => e.Events))
	{
		foreach (var myEvent in eventList)
		{
			if (!PayoutCalculator.IsMainEvent(myEvent)) continue;
			payoutList = PayoutCalculator.CalcPayout(myEvent.NumEntrants).ToList();
			<h3>@myEvent.Name</h3>
			<h4>@($"Number of entrants: {myEvent.NumEntrants}")</h4>
			<p>@($"Prize Pool: ${payoutList.Sum()}")</p>
			<table class="table">
				<thead>
					<tr>
						<th>Placement</th>
						<th>Name</th>
						<th>Earnings</th>
					</tr>
					@for (int i = 0; i < payoutList.Count && i < myEvent.Standings.Nodes.Count; i++)
					{
						var payoutItem = payoutList[i];
						var standingsItem = myEvent.Standings.Nodes[i];
						<tr>
							<td>@standingsItem.Placement</td>
							<td>@(standingsItem.Player?.gamerTag ?? "Unknown")</td>
							<td>$@payoutItem</td>
						</tr>
					}
				</thead>
			</table>
			<br />
		}
	}}
@code {

	private TournamentResponse? tdata;
	private string? loadError;
	private List<double> payoutList = new();

	protected override async Task OnInitializedAsync()
	{
		try
		{
			tdata = await TournamentData.GetTournamentsAsync();
		}
		catch (Exception ex)
		{
			loadError = "Couldn't load results from start.gg right now. Try refreshing in a minute.";
			Console.Error.WriteLine(ex);
		}
	}
}
